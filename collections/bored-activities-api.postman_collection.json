        {
          "id": "ab8852db-bc8f-4279-ac5f-4b1304d34770",
          "name": "Get a Random Activity",
          "request": {
            "name": "Get a Random Activity",
            "description": {
              "content": "Returns a single random activity, optionally filtered by type, participant count, price range, accessibility (availability), or a specific activity key. Identical to /api/v1/activity.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "activity"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter activities by category type."
                },
                {
                  "disabled": false,
                  "key": "participants",
                  "value": "<integer>",
                  "description": "Filter to activities requiring an exact number of participants."
                },
                {
                  "disabled": false,
                  "key": "minparticipants",
                  "value": "<integer>",
                  "description": "Filter to activities requiring at least this many participants."
                },
                {
                  "disabled": false,
                  "key": "maxparticipants",
                  "value": "<integer>",
                  "description": "Filter to activities requiring at most this many participants."
                },
                {
                  "disabled": false,
                  "key": "price",
                  "value": "<float>",
                  "description": "V1 — exact price as a decimal between 0.0 (free) and 1.0 (expensive)."
                },
                {
                  "disabled": false,
                  "key": "minprice",
                  "value": "<float>",
                  "description": "V1 — minimum price (0.0–1.0, inclusive)."
                },
                {
                  "disabled": false,
                  "key": "maxprice",
                  "value": "<float>",
                  "description": "V1 — maximum price (0.0–1.0, inclusive)."
                },
                {
                  "disabled": false,
                  "key": "accessibility",
                  "value": "<float>",
                  "description": "V1 — accessibility (also called availability) as a decimal between 0.0 (most accessible) and 1.0 (least accessible)."
                },
                {
                  "disabled": false,
                  "key": "minaccessibility",
                  "value": "<float>",
                  "description": "V1 — minimum accessibility (0.0–1.0)."
                },
                {
                  "disabled": false,
                  "key": "maxaccessibility",
                  "value": "<float>",
                  "description": "V1 — maximum accessibility (0.0–1.0)."
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "Look up a single activity by its unique key."
                }
              ],
              "variable": []
            },
